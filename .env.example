# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Public SEO origin for build-time canonical URLs. Match SITE_URL in wrangler.toml.
SITE_URL="https://accounts.aryuki.com"
# Set a non-production value on preview/staging Workers so they return noindex.
ENVIRONMENT="development"
# Optional Search Console URL-prefix verification; DNS Domain Property is preferred.
# GOOGLE_SITE_VERIFICATION=""

# Auth Center Google OAuth (use Wrangler secrets for production).
GOOGLE_CLIENT_ID="REPLACE_GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="REPLACE_GOOGLE_CLIENT_SECRET"
# Alternative: one Worker secret containing both client_id and client_secret as JSON.
GOOGLE_OAUTH_CREDENTIALS='{"client_id":"REPLACE_GOOGLE_CLIENT_ID","client_secret":"REPLACE_GOOGLE_CLIENT_SECRET"}'
GOOGLE_BIRTHDAY_SCOPE_ENABLED="false"
